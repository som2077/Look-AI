# ─── Clerk Auth ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Play Billing (set via `supabase secrets set` — NOT in .env) ───────
# These are server-side only. Do NOT prefix with EXPO_PUBLIC_.
#
# GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.lookai
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# RTDN_BEARER_TOKEN=your-secret-rtdn-bearer-token

# ─── Removed (old non-compliant payment vars — DELETE from your .env) ─────────
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_API_KEY=your_api_key
EXPO_PUBLIC_CLOUDINARY_API_SECRET=your_api_secret
# EXPO_PUBLIC_RAZORPAY_PRO_PLAN_ID     ← DELETE
# EXPO_PUBLIC_RAZORPAY_PREMIUM_PLAN_ID ← DELETE
# EXPO_PUBLIC_STRIPE_PRO_PRICE_ID      ← DELETE
# EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID  ← DELETE
# EXPO_PUBLIC_PAYMENTS_API_BASE_URL    ← DELETE

# ─── Sentry (Error Tracking & Performance) ─────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=https://key@o123456.ingest.sentry.io/123456
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Sentry CLI vars (build time only — for source map uploads)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Supabase Edge Functions (Set via `supabase secrets set`) ─────────
# REMOVEBG_API_KEY=your_removebg_key
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# CLOUDINARY_PRESET=your_unsigned_preset
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key
